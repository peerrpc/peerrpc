{
  "name": "@peerrpc/protocol",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./gen/*": {
      "import": "./dist/gen/*",
      "types": "./dist/gen/*.d.ts"
    },
    "./gen": {
      "import": "./dist/gen/index.js",
      "types": "./dist/gen/index.d.ts"
    }
  },
  "dependencies": {
    "@bufbuild/protobuf": "^1.10.0"
  }
}
