{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "composite": true
  },
  "references": [
    { "path": "packages/peerrpc-protocol" },
    { "path": "packages/peerrpc-transport" },
    { "path": "packages/peerrpc-peer" },
    { "path": "packages/peerrpc-signal" },
    { "path": "packages/peerrpc-rpc" }
  ],
  "files": []
}
